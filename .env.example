# SafeVoice Environment Configuration Template

# Database Settings
POSTGRES_DB=safevoice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# Redis Settings
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# Security & JWT
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MUST_BE_AT_LEAST_256_BITS
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Cloudinary Integration (Media Uploads)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_UPLOAD_PRESET=safevoice_signed_preset

# Brevo Integration (Transactional Emails / OTP)
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=SafeVoice Security

# Firebase Cloud Messaging
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json

# Initial SuperAdmin Credentials
SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@safevoice.org
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_NICKNAME=SuperAdmin

# API & Frontend URLs
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,https://admin.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8080/ws
