# SafeVoice Mobile App (Expo / React Native) Environment Variables Template

# Backend REST API endpoint (Include /api/v1 prefix)
EXPO_PUBLIC_API_URL=http://YOUR_SERVER_IP_OR_DOMAIN:8080/api/v1

# Backend WebSocket STOMP endpoint
EXPO_PUBLIC_WS_URL=ws://YOUR_SERVER_IP_OR_DOMAIN:8080/ws

# Optional Cloudinary upload preset if client-side media signing is used
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
