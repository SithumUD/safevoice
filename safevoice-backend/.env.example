# SafeVoice Backend Environment Variables Template

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/safevoice_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_POSTGRES_PASSWORD

SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

SPRING_FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update

JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MUST_BE_AT_LEAST_256_BITS
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_UPLOAD_PRESET=safevoice_signed_preset

BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=SafeVoice Security

GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json

SEED_ADMIN_ENABLED=true
SEED_ADMIN_EMAIL=admin@safevoice.org
SEED_ADMIN_PASSWORD=AdminPassword123!

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
